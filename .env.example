# Backend (local dev). Copy to backend/.env; `make dev` loads it. Never commit real values.
GCP_PROJECT=your-project-id
REGION=asia-south1
FIRESTORE_DB=dev
PIPELINE_MODE=inline        # inline locally, pubsub in Cloud Run
STORE=firestore             # memory = offline UI work only (no persistence, no vector search)
AUTH_MODE=firebase          # dev = accept "Bearer dev:<uid>", skip App Check (local only)
LLM_MODE=gemini             # fake = recorded fixtures, no paid calls
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
BIGQUERY_ENABLED=0
# FACTCHECK_API_KEY comes from Secret Manager in Cloud Run; locally export it in your shell.
