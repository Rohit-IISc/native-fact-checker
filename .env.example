# Optional local override: copy to backend/.env (gitignored). Values here win over
# backend/.env.defaults; real environment variables (Codespaces secrets) win over both.
# Only put overrides here; the shared non-secret values live in backend/.env.defaults.
#
# STORE=memory              # memory = offline UI work only (no persistence, no vector search)
# AUTH_MODE=dev             # dev = accept "Bearer dev:<uid>", skip App Check (local only)
# LLM_MODE=fake             # fake = recorded fixtures, no paid calls
# APP_CHECK_ENFORCE=true
# BIGQUERY_ENABLED=0
# PUBLIC_BASE_URL=http://localhost:5173    # ignored in Codespaces (forwarded URL is used)
# CORS_ORIGINS=http://localhost:5173       # the Codespaces forwarded URL is always added
#
# Secrets are never stored in files: FACTCHECK_API_KEY comes from Codespaces secrets locally
# and from Secret Manager in Cloud Run.
