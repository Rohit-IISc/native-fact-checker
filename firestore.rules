rules_version = '2';
// Clients read only their own checks, user doc and history. All writes go through the backend
// (Admin SDK bypasses rules). Verdicts are read through GET /v1/results/{id}, never directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /checks/{checkId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /history/{checkId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
