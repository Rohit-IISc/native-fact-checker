# Non-secret values live in frontend/.env.development (committed). Secret-ish keys come from
# Codespaces secrets as environment variables, which Vite reads directly:
#   VITE_FIREBASE_API_KEY, VITE_FIREBASE_APP_ID, VITE_FIREBASE_VAPID_KEY,
#   VITE_RECAPTCHA_ENTERPRISE_SITE_KEY
# For a machine without Codespaces secrets, put them in frontend/.env.development.local (gitignored).
#
# VITE_AUTH_MODE=dev   # no Firebase: fake sign-in + polling. Pair with AUTH_MODE=dev on the backend.
